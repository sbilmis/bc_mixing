Notebook[{
  Cell["B_c Mixing Angle: Independent Coordinate-Space OPE", "Title"],
  Cell["This notebook is for deriving the coordinate-space G2 and G3 condensate terms independently. It does not load BcMixingMomentum.wl.", "Text"],

  Cell["Load OPE Workbench", "Section"],
  Cell[BoxData["SetDirectory[NotebookDirectory[]];"], "Input"],
  Cell[BoxData["Get[\"BcMixingCoordinateOPE.wl\"];"], "Input"],
  Cell[BoxData["CoordinateOPEEnvironment[] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEStatus[] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG2Status[\"AA\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG2KernelReport[\"AA\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEMixingChannels[]"], "Input"],
  Cell[BoxData["CoordinateOPEG2CompletionReport[] // Short"], "Input"],

  Cell["Reduction Identities", "Section"],
  Cell[BoxData["CoordinateOPEBesselIdentity[nu, mQ, r, t]"], "Input"],
  Cell[BoxData["CoordinateOPEGaussianFourierRule[A, ell] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPESchwingerVariableRecipe[x] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPESupportRule[x, s] // TraditionalForm"], "Input"],
  Cell[BoxData["CoordinateOPEDeltaDerivativeRule[F[x], 0, x, s, M2] // TraditionalForm"], "Input"],
  Cell[BoxData["CoordinateOPEDeltaDerivativeRule[F[x], 1, x, s, M2] // TraditionalForm"], "Input"],
  Cell[BoxData["CoordinateOPEDeltaDerivativeRule[F[x], 2, x, s, M2] // TraditionalForm"], "Input"],

  Cell["FeynCalc Derivative Audit", "Section"],
  Cell["This checks the Gaussian source multipliers with FeynCalc FourDivergence and FourLaplacian. All entries in the Difference column should be zero.", "Text"],
  Cell[BoxData["CoordinateOPEFeynCalcGaussianMultiplierReport[] // Dataset"], "Input"],
  Cell[BoxData["Lookup[CoordinateOPEFeynCalcGaussianMultiplierReport[][\"PowerChecks\"], \"Difference\"]"], "Input"],

  Cell["Local G2 Kernels", "Section"],
  Cell["These are kernel-level coordinate-space expressions. They are not yet independent numerical Borel moments.", "Text"],
  Cell[BoxData["CoordinateOPEReductionPlan[\"G2c\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelInventory[\"AA\", \"G2c\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelInventory[\"AA\", \"G2b\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelReductionTable[\"AA\", \"G2c\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelReductionTable[\"AA\", \"G2b\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelBorelTemplate[\"AA\", \"G2c\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernelBorelTemplate[\"AA\", \"G2b\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernelWeightRecipe[\"AA\", \"G2c\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernelWeightRecipe[\"AA\", \"G2b\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernel[\"AA\", \"G2c\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernel[\"AA\", \"G2b\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernel[\"AA\", \"G2local\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernelTable[\"G2local\"] // Short"], "Input"],

  Cell["All Mixing Channels: G2 Reduction Workbook", "Section"],
  Cell["These cells prepare the kernel and reduction-recipe inventory needed for the mixing angle channels AA, AB and BB.", "Text"],
  Cell[BoxData["CoordinateOPEG2ReductionWorkbook[] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEResidualPowerSummary[\"AA\", \"G2full\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEResidualPowerSummary[\"AB\", \"G2full\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEResidualPowerSummary[\"BB\", \"G2full\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPERequiredWeightSymbols[\"AA\", \"G2full\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPERequiredWeightSymbols[\"AB\", \"G2full\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPERequiredWeightSymbols[\"BB\", \"G2full\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEMissingWeightReport[\"AA\", \"G2full\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEMissingWeightReport[\"AB\", \"G2full\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEMissingWeightReport[\"BB\", \"G2full\"] // Short"], "Input"],

  Cell["Term-Level Derivation Sheets", "Section"],
  Cell["Use these sheets to inspect the explicit W[index,n,x] functions. The dimension-4 G2c, G2b, and G2gg pieces now have direct pole-weight reductions; the old manual installation path is kept for future noncanonical kernels.", "Text"],
  Cell[BoxData["CoordinateOPEKernelDerivationSheets[\"AA\", \"G2c\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernelDerivationSheets[\"AA\", \"G2b\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernelDerivationSheets[\"AA\", \"G2gg\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEG2PoleWeights[\"AA\", \"G2c\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG2PoleWeights[\"AA\", \"G2b\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG2PoleWeightCheck @@@ Tuples[{ {\"AA\", \"AB\", \"BB\"}, {\"G2c\", \"G2b\", \"G2gg\"}}]"], "Input"],
  Cell[BoxData["CoordinateOPEInstalledWeightKeys[]"], "Input"],

  Cell["Full G2: Open-Field Cross-Line Term", "Section"],
  Cell["The full dimension-4 G2 sector now has an explicit independent pole-weight reduction: G2full = G2c + G2b + G2gg. Inspect the weights and exact reconstruction checks before using the numerical moments.", "Text"],
  Cell[BoxData["CoordinateOPEG2ggOpenFieldPropagatorNote[] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG2ggContraction[]"], "Input"],
  Cell[BoxData["CoordinateOPEReductionPlan[\"G2gg\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelInventory[\"AA\", \"G2gg\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelInventory[\"AA\", \"G2full\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelReductionTable[\"AA\", \"G2gg\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelReductionTable[\"AA\", \"G2full\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelBorelTemplate[\"AA\", \"G2gg\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernelBorelTemplate[\"AA\", \"G2full\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernelWeightRecipe[\"AA\", \"G2gg\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernelWeightRecipe[\"AA\", \"G2full\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEG2ggPoleWeights[\"AA\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG2ggPoleWeights[\"AB\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG2ggPoleWeights[\"BB\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG2ggPoleWeightCheck /@ {\"AA\", \"AB\", \"BB\"}"], "Input"],
  Cell[BoxData["CoordinateOPEKernel[\"AA\", \"G2gg\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernel[\"AA\", \"G2full\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEExportG2KernelsTeX[\"AA\"]"], "Input"],
  Cell[BoxData["CoordinateOPEExportG2ReductionTeX[\"AA\"]"], "Input"],
  Cell[BoxData["CoordinateOPEExportAllG2KernelsTeX[]"], "Input"],
  Cell[BoxData["CoordinateOPEExportAllG2ReductionTeX[]"], "Input"],
  Cell[BoxData["CoordinateOPEBorelMoment[\"AA\", \"pert\", 8.0, 54.0]"], "Input"],
  Cell[BoxData["CoordinateOPEBorelMoment[\"AA\", \"G2c\", 8.0, 54.0]"], "Input"],
  Cell[BoxData["CoordinateOPEBorelMoment[\"AA\", \"G2b\", 8.0, 54.0]"], "Input"],
  Cell[BoxData["CoordinateOPEBorelMoment[\"AA\", \"G2gg\", 8.0, 54.0]"], "Input"],
  Cell[BoxData["CoordinateOPEBorelMoment[\"AA\", \"G2full\", 8.0, 54.0]"], "Input"],
  Cell[BoxData["CoordinateOPEMixingAngleWithG2gg[8.0, 54.0]"], "Input"],
  Cell[BoxData["CoordinateOPEMixingAngle[8.0, 54.0, \"pertG2full\"]"], "Input"],

  Cell["Local G3 Kernels", "Section"],
  Cell["G3c and G3b are implemented as the independent single-line dimension-6 truncation. No open-field cross-line dimension-6 terms are included in this convention.", "Text"],
  Cell[BoxData["CoordinateOPEReductionPlan[\"G3c\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelInventory[\"AA\", \"G3c\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEKernelInventory[\"AA\", \"G3b\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG3PoleWeights[\"AA\", \"G3c\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG3PoleWeights[\"AA\", \"G3b\"] // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEG3PoleWeightCheck @@@ Tuples[{ {\"AA\", \"AB\", \"BB\"}, {\"G3c\", \"G3b\"}}]"], "Input"],
  Cell[BoxData["CoordinateOPEBorelMoment[\"AA\", \"G3c\", 8.0, 54.0]"], "Input"],
  Cell[BoxData["CoordinateOPEBorelMoment[\"AA\", \"G3b\", 8.0, 54.0]"], "Input"],
  Cell[BoxData["CoordinateOPEBorelMoment[\"AA\", \"G3full\", 8.0, 54.0]"], "Input"],
  Cell[BoxData["CoordinateOPEKernel[\"AA\", \"G3c\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernel[\"AA\", \"G3b\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPEKernel[\"AA\", \"G3local\"] // Short"], "Input"],
  Cell[BoxData["CoordinateOPENumericOPESummary[8.0, 54.0] // Dataset"], "Input"],

  Cell["OPE Hierarchy Across Wang Window", "Section"],
  Cell["Use this scan to check that the coordinate-space condensate corrections remain smaller than the perturbative contribution throughout the chosen auxiliary-parameter window. Increase the third entry in each range for a denser scan.", "Text"],
  Cell[BoxData["coordinateOPEM2Scan = {7.0, 9.0, 3};"], "Input"],
  Cell[BoxData["coordinateOPES0Scan = {53.0, 55.0, 3};"], "Input"],
  Cell[BoxData["coordinateOPEConvergence = CoordinateOPEConvergenceScan[coordinateOPEM2Scan, coordinateOPES0Scan];"], "Input"],
  Cell[BoxData["coordinateOPEConvergence // Dataset"], "Input"],
  Cell[BoxData["CoordinateOPEConvergenceCSVTable[coordinateOPEConvergence] // Grid"], "Input"],
  Cell[BoxData["CoordinateOPEExportConvergenceCSV[coordinateOPEConvergence, \"BcMixingCoordinateOPEConvergence_WangWindow.csv\"]"], "Input"],

  Cell["Complete Dimension-6 Audit", "Section"],
  Cell["This audit separates the coordinate-space single-line G3full result from the open-field cross-line terms that would be needed for a complete dimension-6 coordinate-space OPE.", "Text"],
  Cell[BoxData["Get[\"BcMixingDimension6Complete.wl\"];"], "Input"],
  Cell[BoxData["D6CompletenessReport[] // Dataset"], "Input"],
  Cell[BoxData["D6CrossLineKernelTemplate[\"AA\"] // Dataset"], "Input"],

  Cell["Publication Checklist", "Section"],
  Cell[BoxData["CoordinateOPEJournalChecklist[] // Dataset"], "Input"]
},
WindowTitle -> "B_c Coordinate-Space OPE Workbench",
WindowSize -> {1150, 760},
WindowMargins -> {{Automatic, 80}, {Automatic, 30}},
StyleDefinitions -> "Default.nb"]
