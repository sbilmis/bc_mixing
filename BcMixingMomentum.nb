                Blank[C]][$CellContext`rho, $CellContext`sigma]]], "Status" -> 
           "Missing: needs open two-gluon heavy-quark propagator"|>, <|
          "Dimension" -> 6, "Order" -> "G3cross-c1-b2", "OperatorProduct" -> 
           "S_c^(G,open) S_b^(GG,open)", "VacuumAverage" -> HoldForm[
             $CellContext`VacuumAverage[Pattern[$CellContext`g, 
                 Blank[$CellContext`s]]^3 Pattern[$CellContext`G, 
                Blank[$CellContext`A]][$CellContext`alpha, $CellContext`beta] 
              Pattern[$CellContext`G, 
                Blank[$CellContext`B]][$CellContext`rho, $CellContext`sigma] 
              Pattern[$CellContext`G, 
                Blank[C]][$CellContext`lambda, $CellContext`tau]]], "Status" -> 
           "Missing: needs open two-gluon heavy-quark propagator"|>}, 
        "DoNotDoubleCount" -> 
        "The cross-line terms are not contained in the vacuum-averaged \
single-line S^(G3) propagator.", "CandidateTripleVacuumAverage" -> 
        HoldForm[$CellContext`VacuumAverage[Pattern[$CellContext`g, 
               
               Blank[$CellContext`s]]^3 $CellContext`G[$CellContext`A, \
