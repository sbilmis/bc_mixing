Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"D6CompletionChecklist", "[", "]"}], " ", "//", " ", 
  "Column"}]], "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"0eb35939-499f-4706-b13e-7005ea8977fc"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"Fix the exact open two-gluon heavy-quark propagator S_Q^(GG,open) \
in the same convention as SGNum.\"\>"},
     {"\<\"Check the triple-gluon vacuum tensor normalization and sign \
against the definition of <g_s^3 G^3> used in the paper.\"\>"},
     {"\<\"Build the two cross-line kernels S_c^(GG)S_b^(G) and \
S_c^(G)S_b^(GG) for AA, AB and BB.\"\>"},
     {"\<\"Reduce the kernels to scalar Feynman-parameter amplitudes.\"\>"},
     {"\<\"Convert amplitudes into direct Borel pole weights and test \
reconstruction against the amplitude.\"\>"},
     {"\<\"Only after these checks, define G3complete = G3c + G3b + G3cross \
and totalComplete = pert + G2full + G3complete.\"\>"}
    },
    DefaultBaseStyle->"Column",
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Column"], TraditionalForm]], "Output",
 CellChangeTimes->{3.990428999219694*^9},
 CellLabel->"Out[72]=",ExpressionUUID->"9e8698f5-b41b-4a63-9a9a-26c573d84a1b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"TrueQ", "[", "runCompleteD6CrossLineTest", "]"}], ",", "\n", "  ", 
   RowBox[{"D6NumericBorelPiCrossLine", "[", "\n", "    ", 
    RowBox[{"\"\<AA\>\"", ",", " ", "8.0", ",", " ", "54.0", ",", " ", 
     "$BcMixingDefaultParameters", ",", " ", "\"\<c2b1\>\"", ",", "\n", 
     "    ", 
     RowBox[{"WorkingPrecision", " ", "->", " ", "MachinePrecision"}], ",", 
     "\n", "    ", 
     RowBox[{"AccuracyGoal", " ", "->", " ", "6"}], ",", "\n", "    ", 
     RowBox[{"PrecisionGoal", " ", "->", " ", "6"}]}], "\n", "  ", "]"}], ",",
    "\n", "  ", "\"\<Complete dimension-6 cross-line test skipped. Set \
runCompleteD6CrossLineTest = True to run it.\>\""}], "\n", "]"}]], "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"59467201-748c-403c-92fe-ae8ea3b93f27"],

Cell[BoxData[
 FormBox["\<\"Complete dimension-6 cross-line test skipped. Set \
runCompleteD6CrossLineTest = True to run it.\"\>", TraditionalForm]], "Output",\

 CellChangeTimes->{3.990428999229384*^9},
 CellLabel->"Out[73]=",ExpressionUUID->"6a275a3d-58c1-41c9-bf92-6a62a99ea70e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["G3 Caveat", "Section",ExpressionUUID->"36451e2e-fac0-4cd2-ae08-3439e4a1eac5"],

Cell["\<\
The default total result includes the standard vacuum-averaged single-line \
contribution S_c^(G3) S_b^0 + S_c^0 S_b^(G3). The optional totalCompleteD6 \
curve adds the cached open-field cross-line G3 pieces on an M2 grid.\
\>", "Text",ExpressionUUID->"9579097d-ea7c-4928-acec-00aa1fdb2da2"]
}, Open  ]]
}, Open  ]]
