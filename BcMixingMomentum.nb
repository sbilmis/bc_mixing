Cell["Alpha_s K-Factor Sensitivity", "Section",ExpressionUUID->"9e20cfec-2e52-4b49-8237-65cd2c3756ae"],

Cell["\<\
This is not a full NLO calculation. It rescales only the perturbative moment \
by 1 + alphaS K_ij/Pi and leaves G2/G3 unchanged.\
\>", "Text",ExpressionUUID->"24336a9f-8114-4584-a768-0d53e0da8ad1"],

