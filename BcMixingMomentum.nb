 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"mb\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"4.16`", ",", "4.21`"}], "}"}]}], ",", 
    RowBox[{"\<\"mc\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1.25`", ",", "1.29`"}], "}"}]}], ",", 
    RowBox[{"\<\"G2\"\>", "\[Rule]", 
     RowBox[{"{", 
