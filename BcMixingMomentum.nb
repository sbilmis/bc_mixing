    RowBox[{"\<\"G3\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0.28`", ",", "0.86`"}], "}"}]}], ",", 
    RowBox[{"\<\"M2\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"8.`", ",", "12.`"}], "}"}]}], ",", 
    RowBox[{"\<\"s0\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"50.`", ",", "60.`"}], "}"}]}]}], "\[RightAssociation]"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{3.990086343715254*^9, 3.990087330647681*^9},
