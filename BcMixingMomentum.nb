Cell[CellGroupData[{

Cell["Complete-D6 M2 Grid", "Section",ExpressionUUID->"07b91470-37f2-4522-814c-729d711ee43d"],

Cell["\<\
This block is the slow but clean way to add the open-field cross-line \
dimension-6 correction to the theta-vs-M2 contribution plot. Leave \
generateCompleteD6CrossLineM2Grid = False to only load an existing cache. Set \
it to True when you are ready to compute the grid; each M2 point is cached in \
completeD6CrossLineCacheDirectory.\
\>", "Text",ExpressionUUID->"b3c9dc26-b7a2-4fe9-b0c9-4116ff1d9f64"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"completeD6CrossLineM2Grid", " ", "=", " ", 
   RowBox[{"If", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"TrueQ", "[", "generateCompleteD6CrossLineM2Grid", "]"}], ",", 
     "\n", "  ", 
     RowBox[{"D6ComputeCrossLineM2Grid", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"$BcMixingWangWindow", "[", "\"\<M2Range\>\"", "]"}], ",", 
       "\n", "    ", "completeD6PlotS0", ",", "\n", "    ", 
       "$BcMixingDefaultParameters", ",", "\n", "    ", 
       RowBox[{"\"\<NPoints\>\"", " ", "->", " ", "completeD6GridNPoints"}], ",",
        "\n", "    ", 
       RowBox[{"\"\<CacheDirectory\>\"", " ", "->", " ", 
        "completeD6CrossLineCacheDirectory"}], ",", "\n", "    ", 
       RowBox[{"\"\<Overwrite\>\"", " ", "->", " ", 
        "overwriteCompleteD6CrossLineM2Grid"}], ",", "\n", "    ", 
       RowBox[{"\"\<Progress\>\"", " ", "->", " ", "True"}], ",", "\n", 
       "    ", 
       RowBox[{"WorkingPrecision", " ", "->", " ", "MachinePrecision"}], ",", 
       "\n", "    ", 
       RowBox[{"AccuracyGoal", " ", "->", " ", "6"}], ",", "\n", "    ", 
       RowBox[{"PrecisionGoal", " ", "->", " ", "6"}]}], "\n", "  ", "]"}], ",",
      "\n", "  ", 
     RowBox[{"D6LoadCrossLineM2Grid", "[", "\n", "    ", 
      RowBox[{
      "completeD6PlotS0", ",", "\n", "    ", "completeD6GridNPoints", ",", 
       "\n", "    ", "completeD6CrossLineCacheDirectory"}], "\n", "  ", 
      "]"}]}], "\n", "]"}]}], 
  ";"}], "\n", "completeD6CrossLineM2Grid"}], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"b2089b54-57b0-4078-9ae6-9d20c74bc925"],

