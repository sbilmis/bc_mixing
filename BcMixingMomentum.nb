Cell[CellGroupData[{

Cell["Optional Manual Override", "Section",ExpressionUUID->"a4b5bcd7-bb83-45fc-95ea-5e8cfd7955b6"],

Cell["\<\
The current workflow installs perturbative rho automatically and evaluates \
G2/G3 as direct Borel moments. Use SetSpectralDensity only if you want to \
override a built-in perturbative spectral density for an independent \
cross-check.\
\>", "Text",ExpressionUUID->"57c0bd23-65f6-43ff-823f-027e723ed60c"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"SetSpectralDensity", "[", 
    RowBox[{"\"\<AA\>\"", ",", "\"\<pert\>\"", ",", 
     RowBox[{"rhoAApertIndependent", "[", "s", "]"}], ",", "s"}], "]"}], 
   ";"}], "*)"}]], "Input",
 CellLabel->
  "In[265]:=",ExpressionUUID->"92a3e342-ff56-4468-80b5-5747c427aa8f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["G3 Caveat", "Section",ExpressionUUID->"57040860-b82d-4539-a6fe-511a3cf28fd2"],

Cell["\<\
The implemented G3 term is the standard vacuum-averaged single-line \
contribution S_c^(G3) S_b^0 + S_c^0 S_b^(G3). Cross-line open-field G3 terms \
require a separate derivation and are not guessed in this file.\
\>", "Text",ExpressionUUID->"dd31f4fe-cb55-4f78-9b9c-a027e6224ab4"]
}, Open  ]]
}, Open  ]]
},
