    RowBox[{"\<\"NumericalOrders\"\>", "\[Rule]", 
     RowBox[{"{", "\<\"pert\"\>", "}"}]}], ",", 
    RowBox[{"\<\"ReducedLocalOrders\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\<\"G2c\"\>", ",", "\<\"G2b\"\>", ",", "\<\"G2local\"\>", 
       ",", "\<\"G3c\"\>", ",", "\<\"G3b\"\>", ",", "\<\"G3local\"\>", 
       ",", "\<\"pertG2local\"\>", ",", "\<\"totalLocal\"\>"}], "}"}]}], ",", 
    
    RowBox[{"\<\"IndependentPendingOrders\"\>", "\[Rule]", 
     RowBox[{"{", 
