Notebook[{
  Cell["B_c Mixing Angle: Coordinate-Space Cross-Check", "Title"],

  Cell["This notebook is intentionally separate from the momentum-space notebook. Evaluate the coordinate-space cells first without loading BcMixingMomentum.wl. The momentum-space comparison is placed only at the end so the perturbative coordinate-space result can be checked blindly.", "Text"],

  Cell["Load Coordinate-Space File", "Section"],
  Cell[BoxData["SetDirectory[NotebookDirectory[]];"], "Input"],
  Cell[BoxData["Get[\"BcMixingCoordinate.wl\"]"], "Input"],
  Cell[BoxData["CoordinateCheckEnvironment[]"], "Input"],

  Cell["Reference Formulae And Scope", "Section"],
  Cell["The coordinate-space v1 file implements the perturbative two-heavy-quark check. The G2 and G3 x-space propagator kernels are displayed below as extension points, but their spectral/Borel reduction is not switched on yet.", "Text"],
  Cell[BoxData["CoordinateSpectralDensityDerivationNote[]"], "Input"],
  Cell[BoxData["CoordinateHeavyPropagatorFree[mQ, 1, GS[xv], r] // TraditionalForm"], "Input"],
  Cell[BoxData["CoordinateHeavyPropagatorG2Kernel[mQ, 1, GS[xv], r, x2] // TraditionalForm"], "Input"],
  Cell[BoxData["CoordinateHeavyPropagatorG3Kernel[mQ, 1, GS[xv], r, x2] // TraditionalForm"], "Input"],

  Cell["Coordinate-Space Trace Kernels", "Section"],
  Cell["These cells build the projected x-space trace kernels before the Bessel/Schwinger reduction to the perturbative spectral density.", "Text"],
  Cell[BoxData["CoordinateTraceKernel[\"AA\", \"pert\"] // Short"], "Input"],
  Cell[BoxData["CoordinateTraceKernel[\"AB\", \"pert\"] // Short"], "Input"],
  Cell[BoxData["CoordinateTraceKernel[\"BB\", \"pert\"] // Short"], "Input"],
  Cell[BoxData["CoordinateTraceKernelTable[] // Short"], "Input"],

  Cell["Perturbative Spectral Densities", "Section"],
  Cell["The installed perturbative spectral densities are the coordinate-space Bessel/Schwinger reduced forms. They should be checked channel by channel before moving to condensates.", "Text"],
  Cell[BoxData["CoordinatePerturbativeSpectralDensity[\"AA\", s] // Simplify // TraditionalForm"], "Input"],
  Cell[BoxData["CoordinatePerturbativeSpectralDensity[\"AB\", s] // Simplify // TraditionalForm"], "Input"],
  Cell[BoxData["CoordinatePerturbativeSpectralDensity[\"BB\", s] // Simplify // TraditionalForm"], "Input"],

  Cell["Single Numerical Point", "Section"],
  Cell["This is the first blind numerical check. It uses only BcMixingCoordinate.wl.", "Text"],
  Cell[BoxData["m2Test = 8.0;"], "Input"],
  Cell[BoxData["s0Test = 54.0;"], "Input"],
  Cell[BoxData["CoordinateNumericOPESummary[m2Test, s0Test]"], "Input"],
  Cell[BoxData["CoordinateNumericMixingAngleDegrees[m2Test, s0Test, \"pert\"]"], "Input"],

  Cell["Wang-Window Coordinate Grid", "Section"],
  Cell["Use the Wang auxiliary window for the perturbative blind check before comparing with the momentum-space file.", "Text"],
  Cell[BoxData["$BcCoordinateWangWindow"], "Input"],
  Cell[BoxData["coordWangGrid = CoordinateWangWindowGrid[];"], "Input"],
  Cell[BoxData["Dataset[coordWangGrid]"], "Input"],
  Cell[BoxData["coordWangCSVTable = Prepend[(Lookup[#, {\"M2\", \"s0\", \"ThetaPertDeg\"}] &) /@ coordWangGrid, {\"M2\", \"s0\", \"ThetaPertDeg\"}];"], "Input"],
  Cell[BoxData["Export[\"BcMixingCoordinate_WangWindow_pert.csv\", coordWangCSVTable]"], "Input"],

  Cell["Coordinate Stability Plots", "Section"],
  Cell["These are simple blind-check plots. They are intentionally independent of the publication plotting functions in BcMixingMomentum.wl.", "Text"],
  Cell[BoxData["coordM2Data = Association@Table[s0v -> Table[{m2v, CoordinateNumericMixingAngleDegrees[m2v, s0v, \"pert\"]}, {m2v, Subdivide[$BcCoordinateWangWindow[\"M2Range\"][[1]], $BcCoordinateWangWindow[\"M2Range\"][[2]], 24]}], {s0v, $BcCoordinateWangWindow[\"s0Values\"]}];"], "Input"],
  Cell[BoxData["ListLinePlot[Values[coordM2Data], Frame -> True, Axes -> False, FrameLabel -> {Row[{Superscript[\"M\", 2], \" (\", Superscript[\"GeV\", 2], \")\"}], Superscript[\"\\[Theta]\", \"\\[Degree]\"]}, PlotLegends -> Placed[LineLegend[Row[{Subscript[\"s\", 0], \" = \", #, \" \", Superscript[\"GeV\", 2]}] & /@ Keys[coordM2Data]], Right], PlotMarkers -> Automatic, ImageSize -> 540]"], "Input"],
  Cell[BoxData["coordS0Data = Association@Table[m2v -> Table[{s0v, CoordinateNumericMixingAngleDegrees[m2v, s0v, \"pert\"]}, {s0v, Subdivide[$BcCoordinateWangWindow[\"s0Range\"][[1]], $BcCoordinateWangWindow[\"s0Range\"][[2]], 24]}], {m2v, $BcCoordinateWangWindow[\"M2Values\"]}];"], "Input"],
  Cell[BoxData["ListLinePlot[Values[coordS0Data], Frame -> True, Axes -> False, FrameLabel -> {Row[{Subscript[\"s\", 0], \" (\", Superscript[\"GeV\", 2], \")\"}], Superscript[\"\\[Theta]\", \"\\[Degree]\"]}, PlotLegends -> Placed[LineLegend[Row[{Superscript[\"M\", 2], \" = \", #, \" \", Superscript[\"GeV\", 2]}] & /@ Keys[coordS0Data]], Right], PlotMarkers -> Automatic, ImageSize -> 540]"], "Input"],

  Cell["Future G2 Work", "Section"],
  Cell["Do not use the following as final G2 numerical input yet. These cells are for deriving the coordinate-space condensate spectral/Borel pieces from the x-space propagator kernels.", "Text"],
  Cell[BoxData["CoordinateHeavyPropagatorG2Kernel[mc, -1, GS[xv], r, x2]"], "Input"],
  Cell[BoxData["CoordinateHeavyPropagatorG2Kernel[mb, 1, GS[xv], r, x2]"], "Input"],
  Cell[BoxData["CoordinateHeavyPropagatorG3Kernel[mc, -1, GS[xv], r, x2]"], "Input"],
  Cell[BoxData["CoordinateHeavyPropagatorG3Kernel[mb, 1, GS[xv], r, x2]"], "Input"],
  Cell[BoxData["CoordinateTraceKernel[\"AA\", \"G2c\"] // Short"], "Input"],
  Cell[BoxData["CoordinateTraceKernel[\"AA\", \"G2b\"] // Short"], "Input"],
  Cell[BoxData["CoordinateTraceKernel[\"AA\", \"G2local\"] // Short"], "Input"],
  Cell[BoxData["CoordinateTraceKernel[\"AA\", \"G3c\"] // Short"], "Input"],
  Cell[BoxData["CoordinateTraceKernel[\"AA\", \"G3b\"] // Short"], "Input"],
  Cell[BoxData["CoordinateTraceKernel[\"AA\", \"G3local\"] // Short"], "Input"],

  Cell["Optional Momentum-Space Comparison", "Section"],
  Cell["Only evaluate this section after the coordinate-space results have been recorded. It loads the momentum-space implementation and compares the perturbative angle.", "Text"],
  Cell[BoxData["Get[\"BcMixingMomentum.wl\"];"], "Input"],
  Cell[BoxData["Get[\"BcMixingCoordinate.wl\"];"], "Input"],
  Cell[BoxData["CoordinateCompareToMomentum[m2Test, s0Test]"], "Input"],
  Cell[BoxData["Table[CoordinateCompareToMomentum[row[\"M2\"], row[\"s0\"]], {row, coordWangGrid}]"], "Input"],

  Cell["Optional Local Condensate Integration", "Section"],
  Cell["These cells use the reduced Feynman/Schwinger helper functions from BcMixingMomentum.wl. They integrate only the local single-line G2/G3 coordinate kernels. The full G2 result still needs the cross-line S^(G)S^(G) term.", "Text"],
  Cell[BoxData["CoordinateCheckEnvironment[]"], "Input"],
  Cell[BoxData["CoordinateLocalCondensateSummary[m2Test, s0Test]"], "Input"],
  Cell[BoxData["CoordinateNumericMixingAngleDegrees[m2Test, s0Test, \"pertG2local\"]"], "Input"],
  Cell[BoxData["CoordinateNumericMixingAngleDegrees[m2Test, s0Test, \"totalLocal\"]"], "Input"],
  Cell[BoxData["CoordinateLocalCondensateComparisonToMomentum[m2Test, s0Test]"], "Input"],
  Cell[BoxData["CoordinateLocalCondensateComparisonToMomentum[m2Test, s0Test, $BcCoordinateDefaultParameters, \"IncludeG3\" -> True]"], "Input"]
},
WindowSize -> {1100, 900},
WindowMargins -> {{Automatic, 80}, {40, Automatic}},
FrontEndVersion -> "14.3 for Mac OS X ARM (64-bit)",
StyleDefinitions -> "Default.nb"
]
