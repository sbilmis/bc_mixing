Cell[CellGroupData[{
Cell["B_c Mixing Angle: Coordinate-Space Calculation", "Title",ExpressionUUID->"44812df7-db92-49ee-990c-28cd107d6c52"],

Cell["\<\
This notebook is the independent coordinate-space workflow. It loads \
BcMixingCoordinate.wl only. Momentum-space comparisons are intentionally kept \
out of the main run so that coordinate-space results can be checked and \
quoted independently.\
\>", "Text",ExpressionUUID->"eb53bf77-1e28-4b2c-bb43-b5046f0993ac"],

