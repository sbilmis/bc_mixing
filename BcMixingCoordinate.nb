  RowBox[{"coordinateRunLocalDiagnostics", " ", "=", " ", "False"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.990180222559362*^9, 
  3.9901802257570887`*^9}},ExpressionUUID->"e594f014-f0de-4e6a-a2b2-\
0674a4dc92bf"],

Cell["\<\
For an independent coordinate-space paper, keep coordinateOrder = \"pert\" \
until the full coordinate-space G2 and G3 reductions are implemented. The \
local condensate bridge can be inspected by setting \
coordinateRunLocalDiagnostics = True, but that bridge is diagnostic only.\
\>", "Text",ExpressionUUID->"17b670d9-dfb5-40e2-9f34-201ddf91e934"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Coordinate-Space Kernels", "Section",ExpressionUUID->"9cdac43e-35e4-4ddb-887e-2dd9927928ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CoordinateSpectralDensityDerivationNote", "[", "]"}]], "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"712ac7c0-fab4-42ab-8e2d-3aa6edb44e33"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"Coordinate-space v1 uses the free heavy-quark propagator\"\>"},
     {
      TagBox[
       RowBox[{
        RowBox[{"S_Q", "(", "x", ")"}], "\[LongEqual]", 
        FractionBox[
         RowBox[{
          SuperscriptBox["m_Q", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{"\[ImaginaryI]", " ", 
               RowBox[{"\[Gamma]", ".", "x"}], " ", 
               TemplateBox[{"2", 
                 RowBox[{"m_Q", " ", 
                   SqrtBox[
                    RowBox[{"-", 
                    SuperscriptBox["x", "2"]}]]}]},
                "BesselK"]}], 
              SuperscriptBox["x", "2"]]}], "+", 
            FractionBox[
             TemplateBox[{"1", 
               RowBox[{"m_Q", " ", 
                 SqrtBox[
                  RowBox[{"-", 
                    SuperscriptBox["x", "2"]}]]}]},
              "BesselK"], 
             SqrtBox[
              RowBox[{"-", 
               SuperscriptBox["x", "2"]}]]]}], ")"}]}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"2", " ", "\[Pi]"}], ")"}], "2"]]}],
       HoldForm]},
     {"\<\"The Fourier transform reduces to radial integrals with one J \
Bessel and two K Bessel functions.\"\>"},
     {"\<\"The spectral density installed here is the perturbative result \
after the Huang-Liu/Azizi Bessel-Schwinger reduction.\"\>"},
     {"\<\"Local single-line G2/G3 condensate checks are available through \
the reduced Borel bridge after loading BcMixingMomentum.wl.\"\>"},
     {"\<\"The full coordinate-space G2 result still needs the open-field \
S^(G) S^(G) cross-line derivation.\"\>"}
    },
    DefaultBaseStyle->"Column",
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Column"], TraditionalForm]], "Output",
 CellChangeTimes->{3.9901800579982853`*^9},
 CellLabel->"Out[59]=",ExpressionUUID->"df548089-6e4b-4dec-ab5c-007b0668c7b2"]
}, Open  ]],

