          RowBox[{"\[LeftSkeleton]", "1", "\[RightSkeleton]"}], "+", 
          RowBox[{"\[LeftSkeleton]", "1", "\[RightSkeleton]"}]}], ")"}]}]}], 
      ")"}]}], 
    RowBox[{"4", " ", 
     SuperscriptBox["\[Pi]", "4"], " ", 
     SuperscriptBox["r", "4"], " ", 
     SuperscriptBox[
      FormBox[
       OverscriptBox[
        FormBox["p",
         TraditionalForm], "_"],
       TraditionalForm], "2"]}]],
   Short], TraditionalForm]], "Output",
